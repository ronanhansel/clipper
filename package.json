{
  "name": "clipper",
  "version": "0.2.15",
  "description": "Agentic video editor framework for TypeScript-authored motion graphics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronanhansel/clipper.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run electron:dev",
    "renderer:dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "electron:dev": "concurrently -k \"tsc -p tsconfig.node.json --watch\" \"npm:renderer:dev\" \"wait-on tcp:5173 dist-electron/main.js && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "format": "prettier --write . --log-level warn",
    "typecheck": "npm run format && tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "dist:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vitejs/plugin-react": "latest",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.11.0",
    "monaco-editor": "^0.55.1",
    "motion": "latest",
    "nanoid": "latest",
    "react": "latest",
    "react-arborist": "^3.5.0",
    "react-dom": "latest",
    "react-hot-toast": "^2.6.0",
    "react-scan": "^0.5.6",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
