{
  "name": "clipper",
  "version": "0.2.20",
  "description": "Agentic video editor framework for TypeScript-authored motion graphics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronanhansel/clipper.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run electron:dev",
    "renderer:dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "electron:dev": "concurrently -k \"tsc -p tsconfig.node.json --watch\" \"npm:renderer:dev\" \"wait-on tcp:5173 dist-electron/main.js && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "format": "prettier --write . --log-level warn",
    "typecheck": "npm run format && tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "icons:generate": "node scripts/generate-icons.mjs",
    "deps:update": "node scripts/update-all-deps.mjs",
    "deps:update:force": "node scripts/update-all-deps.mjs --force-peer-majors",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "dist:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux"
  },
  "dependencies": {
    "@babel/parser": "7.29.3",
    "@babel/traverse": "7.29.0",
    "@monaco-editor/react": "4.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@vitejs/plugin-react": "6.0.2",
    "clsx": "2.1.1",
    "electron-updater": "6.8.3",
    "esbuild-wasm": "0.28.0",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "1.16.0",
    "monaco-editor": "0.55.1",
    "monaco-jsx-highlighter": "2.77.77",
    "motion": "12.40.0",
    "mp4box": "2.3.0",
    "nanoid": "5.1.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hot-toast": "2.6.0",
    "react-scan": "0.5.6",
    "tailwind-merge": "3.6.0",
    "three": "0.184.0",
    "troika-three-text": "0.52.4",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
    "png-to-ico": "3.0.1",
    "prettier": "3.8.3",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "wait-on": "9.0.10"
  }
}
