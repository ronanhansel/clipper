{
  "name": "clipper",
  "version": "0.2.1",
  "description": "Agentic video editor framework for TypeScript-authored motion graphics.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run electron:dev",
    "renderer:dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "electron:dev": "concurrently -k \"tsc -p tsconfig.node.json --watch\" \"npm:renderer:dev\" \"wait-on tcp:5173 dist-electron/main.js && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "render:sample": "tsc -p tsconfig.node.json && electron . --render-video clipper/projects/prj_v01_sample/project.json scn_opening clipper/exports/command-render.mp4",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vitejs/plugin-react": "latest",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.11.0",
    "monaco-editor": "^0.55.1",
    "motion": "latest",
    "nanoid": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "tailwindcss": "^4.2.4",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
